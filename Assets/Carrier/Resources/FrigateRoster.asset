%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00e385d4f739f9845a529c8e15cc4629, type: 3}
  m_Name: FrigateRoster
  m_EditorClassIdentifier: Carrier.Game::CarrierGame.FrigateRoster
  frigates:
  - id: Sentinel
    displayName: Sentinel
    role: 'Gun frigate: all-rounder'
    description: 'The fleet''s workhorse: steady and well protected, with four CIWS mounts, two ball-mounted guns that reach almost anywhere, and a heavy bow beam.'
    prefab: {fileID: 6448264586944369012, guid: 52a8e5fc4e6e715499ceb503d0eebfd5, type: 3}
    category: Frigate
    buildable: 0
  - id: Lancer
    displayName: Lancer
    role: Fast attack frigate
    description: 'Quick and nimble, with twin-gun turrets on both flanks: it picks its fights and runs from the ones it can''t win. A lighter hull and only two CIWS mounts.'
    prefab: {fileID: 6584772668523972196, guid: 2e6f413b173555c4d9c040c6ef687e1c, type: 3}
    category: Frigate
    buildable: 0
  - id: Warden
    displayName: Warden
    role: Heavy escort frigate
    description: 'Long, slow and very hard to kill: the thickest shield of the five, three twin turrets above, below and astern, four CIWS mounts and the biggest hold.'
    prefab: {fileID: 5685080037884968565, guid: 0da039dd9bcd65d4696c30adc7dfbf7a, type: 3}
    category: Frigate
    buildable: 0
  - id: Talon
    displayName: Talon
    role: Strike frigate
    description: 'Built round two heavy twin-gun turrets and the quickest-charging bow beam of the five, and one of the hardest-hitting. It leaves its defence to its guns: one CIWS mount.'
    prefab: {fileID: 2004010807008222541, guid: 82ac0d2159d536d4ba1f4ca619408d3b, type: 3}
    category: Frigate
    buildable: 0
  - id: Vanguard
    displayName: Vanguard
    role: Line cruiser
    description: 'A long, battleship-like line cruiser: six turrets all bearing forward, the toughest hull of the five and the hardest-hitting bow beam, worked by the biggest crew. It is the slowest to get anywhere and turns like it, and carries little.'
    prefab: {fileID: 1075077384385449600, guid: 914cd0692cc69dd4a92769e32856eaa8, type: 3}
    category: Frigate
    buildable: 0
  - id: Halberd
    displayName: Halberd
    role: Missile destroyer
    description: 'A destroyer built round its missiles: twenty-four in the magazine, six cells to fire them from, and eight turrets, the quad mount forward the heaviest. Tougher than any frigate but slower, with no bow beam and only two CIWS mounts.'
    prefab: {fileID: 6988920323682954240, guid: 2071965e035eb2e4dbb4c5dea09a6f08, type: 3}
    category: Destroyer
    buildable: 1
  - id: Rapier
    displayName: Rapier
    role: Fast destroyer
    description: The quickest of the destroyers, long and slender, its seven turrets mostly forward. A light hull for its class, one CIWS mount and twelve missiles.
    prefab: {fileID: 1299532679905645138, guid: 9ce4ff3820dcc524a917dd6ba7c33231, type: 3}
    category: Destroyer
    buildable: 1
  - id: Claymore
    displayName: Claymore
    role: Gun destroyer
    description: 'Three heavy single-gun turrets and five ball mounts: the hardest-hitting guns of the destroyers. Two CIWS mounts and twelve missiles.'
    prefab: {fileID: 287869466903076513, guid: 695fae3d6a87e7943a00fa91847bf778, type: 3}
    category: Destroyer
    buildable: 1
  - id: Bulwark
    displayName: Bulwark
    role: Heavy destroyer
    description: 'The slowest and toughest destroyer: four twin turrets, four flank mounts, two CIWS mounts, sixteen missiles and the biggest hold of its class.'
    prefab: {fileID: 5468149624415462887, guid: 562c37d4ba0b1984e911cb0aed3b22a0, type: 3}
    category: Destroyer
    buildable: 1
  - id: Stiletto
    displayName: Stiletto
    role: Strike destroyer
    description: 'A sleek strike ship: one big dorsal turret, six ball mounts, eight missile cells and twenty missiles to fill them. One CIWS mount.'
    prefab: {fileID: 5571782309096345557, guid: 6ab6a10f4f9d95144a705ef99d37989f, type: 3}
    category: Destroyer
    buildable: 1
  - id: Sovereign
    displayName: Sovereign
    role: Heavy cruiser
    description: 'A heavy cruiser: twelve turrets, six CIWS mounts, a bow beam heavier than any frigate''s, thirty-two missiles and eight cells, and the toughest hull and shield of all. Slow, and it needs a crew of eight hundred.'
    prefab: {fileID: 2359882111312530107, guid: 33dd4678395e6e849ba8384ee387c220, type: 3}
    category: Cruiser
    buildable: 1
