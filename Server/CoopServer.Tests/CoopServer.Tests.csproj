<Project Sdk="Microsoft.NET.Sdk">

  <!-- The co-op server's unit and integration tests: `dotnet test Server/CoopServer.Tests`.
       They compile the server's own Config.cs and Hub.cs (not the program around them), so the
       hub can be driven over WebSocket pairs on loopback TCP without starting a web server. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CoopServer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CoopServer\Config.cs" Link="Server\Config.cs" />
    <Compile Include="..\CoopServer\Hub.cs" Link="Server\Hub.cs" />
    <Compile Include="..\..\Assets\Carrier\Scripts\Net\CoopWire.cs" Link="Server\CoopWire.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
