<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoopServer</AssemblyName>
    <RootNamespace>CoopServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- published as one self-contained file per platform: nothing to install to run it -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- and no CoopServer.Core.pdb beside it: Core keeps its symbols for the tests -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- the rooms and settings (and the protocol file shared with the game) are in CoopServer.Core;
         this is just the web server around them. Publishing bundles Core into the one file. -->
    <ProjectReference Include="..\CoopServer.Core\CoopServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="coopserver.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
