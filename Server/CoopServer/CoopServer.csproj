<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoopServer</AssemblyName>
    <RootNamespace>CoopServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- published as one self-contained file per platform: nothing to install to run it -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- the protocol's version and message names, shared with the game -->
    <Compile Include="..\..\Assets\Carrier\Scripts\Net\CoopWire.cs" Link="Shared\CoopWire.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="coopserver.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
